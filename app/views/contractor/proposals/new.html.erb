<% content_for :title, "Submit a proposal" %>

<%= link_to contractor_available_job_path(@job), class: "mb-3 inline-flex items-center gap-1 text-sm text-brand-700 hover:text-brand-800 dark:text-brand-300" do %>
  <%= icon_tag :arrow_left, classes: "h-4 w-4" %> Back to job details
<% end %>

<%= render "shared/page_header", title: "Submit a proposal", subtitle: "#{@job.title} - #{@job.location_label}" %>

<div class="max-w-2xl <%= panel_card_class %>">
  <%= render "contractor/proposals/form", proposal: @proposal, job: @job, url: contractor_available_job_proposals_path(@job), method: :post %>
</div>
