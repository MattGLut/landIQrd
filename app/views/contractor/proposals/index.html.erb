<% content_for :title, "Proposals" %>

<%= render "shared/page_header", title: "My proposals", subtitle: "Track the pricing you've sent to landlords." %>

<% if @proposals.any? %>
  <div class="space-y-3">
    <% @proposals.each do |proposal| %>
      <%= link_to contractor_proposal_path(proposal), class: "#{grid_card_class} flex flex-wrap items-center justify-between gap-4" do %>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <p class="font-semibold text-slate-900 dark:text-slate-100"><%= proposal.job.title %></p>
            <%= proposal_status_badge(proposal) %>
          </div>
          <p class="text-sm text-slate-500 dark:text-slate-400"><%= proposal.job.location_label %></p>
        </div>
        <div class="text-right">
          <p class="text-lg font-bold text-slate-900 dark:text-slate-100"><%= format_cents(proposal.amount_cents) %></p>
          <p class="text-xs text-slate-500 dark:text-slate-400">Submitted <%= proposal.created_at.strftime("%b %-d") %></p>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "No proposals yet", description: "Find a matching job and send your price.",
        action: render("shared/button", label: "Find work", url: contractor_available_jobs_path, variant: :primary) %>
<% end %>
