<div class="mb-8 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400">Direct assignment</h2>
      <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
        Ask to save this contractor as a personal or business contact. They have to accept before you can assign a quick job.
      </p>
    </div>
    <% if relationship %>
      <div class="flex flex-wrap gap-2">
        <%= status_badge relationship.label, :indigo %>
        <%= status_badge relationship.status_label, relationship.status_color %>
      </div>
    <% end %>
  </div>

  <% if relationship&.status_accepted? %>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-3">
      <%= form_with model: relationship, class: "flex flex-wrap items-end gap-2" do |f| %>
        <div>
          <%= f.label :kind, "Relationship", class: "block text-xs text-slate-500 dark:text-slate-400" %>
          <%= f.select :kind, ContractorRelationship.kinds.keys.map { |kind| [ kind.titleize, kind ] }, {}, class: "#{form_input_class} py-1.5" %>
        </div>
        <%= f.submit "Update", class: button_classes(:secondary, size: :sm), data: { turbo_submits_with: "Saving…" } %>
      <% end %>
      <div class="flex flex-wrap items-center gap-3">
        <%= render "shared/button", label: "Assign a quick job", url: new_quick_job_path(contractor_id: contractor.id), variant: :primary, size: :sm %>
        <%= button_to "Remove contact", contractor_relationship_path(relationship), method: :delete, class: "text-sm text-rose-600 hover:text-rose-700 dark:text-rose-400", form: { data: { turbo_confirm: "Remove this contact? You will need them to accept again before assigning a quick job." } } %>
      </div>
    </div>
  <% elsif relationship&.status_pending? %>
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-300">Waiting for <%= contractor.display_name %> to accept this <%= relationship.kind %> contact.</p>
    <div class="mt-3">
      <%= button_to "Cancel request", contractor_relationship_path(relationship), method: :delete, class: "text-sm text-rose-600 hover:text-rose-700 dark:text-rose-400", form: { data: { turbo_confirm: "Cancel this contact request?" } } %>
    </div>
  <% elsif relationship&.status_declined? %>
    <p class="mt-4 text-sm text-slate-600 dark:text-slate-300"><%= contractor.display_name %> declined this request.</p>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <%= button_to "Request again", request_again_contractor_relationship_path(relationship), class: button_classes(:primary, size: :sm) %>
      <%= button_to "Remove contact", contractor_relationship_path(relationship), method: :delete, class: "text-sm text-rose-600 hover:text-rose-700 dark:text-rose-400" %>
    </div>
  <% else %>
    <%= form_with model: ContractorRelationship.new, url: contractor_relationships_path, class: "mt-4 flex flex-wrap items-end gap-2" do |f| %>
      <%= f.hidden_field :contractor_id, value: contractor.id %>
      <div>
        <%= f.label :kind, "Relationship", class: "block text-xs text-slate-500 dark:text-slate-400" %>
        <%= f.select :kind, ContractorRelationship.kinds.keys.map { |kind| [ kind.titleize, kind ] }, {}, class: "#{form_input_class} py-1.5" %>
      </div>
      <%= f.submit "Send request", class: button_classes(:primary, size: :sm), data: { turbo_submits_with: "Sending…" } %>
    <% end %>
  <% end %>
</div>
