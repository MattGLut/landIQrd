<% content_for :title, "Compare proposals - #{@job.title}" %>

<%= render "jobs/header", job: @job %>
<%= render "jobs/tabs", job: @job, active: :proposals %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <p class="text-sm text-slate-500 dark:text-slate-400">
    <%= pluralize(@proposals.size, "proposal") %> received.
    <% if @job.status_open? %>Select a proposal to award and create a work order.<% end %>
  </p>
  <div class="flex gap-2 text-sm">
    <%= link_to "Lowest price", job_proposals_path(@job, sort: "price"), class: "rounded-full px-3 py-1 font-medium #{@sort == "price" ? "bg-brand-100 text-brand-800 dark:bg-brand-900/30 dark:text-brand-300" : "bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400"}" %>
    <%= link_to "Newest", job_proposals_path(@job, sort: "newest"), class: "rounded-full px-3 py-1 font-medium #{@sort == "newest" ? "bg-brand-100 text-brand-800 dark:bg-brand-900/30 dark:text-brand-300" : "bg-slate-100 text-slate-500 dark:bg-slate-700 dark:text-slate-400"}" %>
  </div>
</div>

<% if @proposals.any? %>
  <div class="space-y-4">
    <% @proposals.each do |proposal| %>
      <% lowest = proposal.amount_cents == @lowest_cents && @proposals.size > 1 %>
      <% contractor = proposal.contractor %>
      <article class="rounded-xl border bg-[var(--color-surface-card)] p-5 shadow-sm <%= lowest ? "border-2 border-brand-400" : "border-[var(--color-border)]" %>">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex min-w-0 items-start gap-3">
            <%= render "shared/user_avatar", user: contractor, size: :lg %>
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <h2 class="font-semibold text-slate-900 dark:text-slate-100"><%= contractor.display_name %></h2>
                <% if lowest %><span class="<%= match_badge_classes %>">Lowest price</span><% end %>
                <%= proposal_status_badge(proposal) if proposal.awarded? %>
              </div>
              <p class="text-xs text-slate-500 dark:text-slate-400"><%= contractor.service_area_label %></p>
              <p class="mt-0.5 text-xs text-slate-500 dark:text-slate-400"><%= contractor.trades.map { |trade| WorkOrder.trade_label(trade) }.to_sentence %></p>
            </div>
          </div>
          <div class="text-right">
            <p class="text-2xl font-bold text-slate-900 dark:text-slate-100"><%= format_cents(proposal.amount_cents) %></p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Start <%= proposal.earliest_start.strftime("%b %-d") %> &middot; <%= proposal.duration_label %></p>
          </div>
        </div>

        <p class="mt-3 text-sm text-slate-700 dark:text-slate-300"><%= truncate(proposal.scope, length: 220) %></p>
        <% if proposal.exclusions.present? %>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Exclusions: <%= truncate(proposal.exclusions, length: 140) %></p>
        <% end %>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <%= link_to "View proposal", job_proposal_path(@job, proposal), class: button_classes(:secondary) %>
          <% if policy(proposal).award? %>
            <%= button_to "Award & create work order", award_job_proposal_path(@job, proposal), method: :post,
                  class: "#{button_classes(:primary)} cursor-pointer",
                  form: { data: { turbo_confirm: "Award this proposal to #{contractor.display_name} and create a work order?" } } %>
          <% end %>
        </div>
        <% if policy(proposal).award? %>
          <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">Awarded scope and price carry into the work order.</p>
        <% end %>
      </article>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state", title: "No proposals yet", description: "Matching contractors will appear here once they submit pricing." %>
<% end %>
