<!DOCTYPE html>
<html class="h-full bg-[var(--color-surface)]" data-controller="theme">
  <head>
    <title><%= content_for(:title) || "landIQrd" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="landIQrd">
    <meta name="theme-color" content="#12203b">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="flex min-h-full items-center justify-center bg-[var(--color-surface)] px-4 py-12 text-[var(--color-text-primary)] antialiased">
    <%= render "shared/flash" %>
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <%= link_to root_path, class: "inline-block" do %>
          <%= render "shared/wordmark", size: "text-5xl" %>
        <% end %>
        <div class="mx-auto mt-4 h-0.5 w-12 rounded bg-brand-400"></div>
      </div>
      <%= yield %>
    </div>
  </body>
</html>
