<% content_for :title, "Walkthroughs - #{@job.title}" %>
<% label_class = "block text-sm font-medium text-slate-700 dark:text-slate-300" %>
<% can_edit_slots = policy(WalkthroughSlot.new(job: @job)).create? %>

<% if @job.status_draft? %>
  <%= render "jobs/steps", current: 2, job: @job %>
  <%= render "shared/page_header", title: "Set walkthrough availability", subtitle: "Choose when contractors can walk the site before bidding. This step is optional." %>
<% else %>
  <%= render "jobs/header", job: @job %>
  <%= render "jobs/tabs", job: @job, active: :walkthroughs %>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <% if can_edit_slots %>
      <%= form_with url: job_walkthrough_slots_path(@job), method: :post, class: "#{panel_card_class} space-y-5" do %>
        <div>
          <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Set walkthrough availability</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400">Choose when contractors can schedule a walkthrough for this job.</p>
        </div>

        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <%= label_tag :date, "Date", class: label_class %>
            <%= date_field_tag :date, Date.tomorrow, min: Date.current, class: form_input_class %>
          </div>
          <div>
            <%= label_tag :duration_minutes, "Duration", class: label_class %>
            <%= select_tag :duration_minutes, options_for_select(JobsHelper::WALKTHROUGH_DURATIONS, 30), class: form_input_class %>
          </div>
          <div>
            <%= label_tag :timezone, "Timezone", class: label_class %>
            <%= select_tag :timezone, options_for_select(Job::TIMEZONES.map { |zone| [ zone.sub(" (US & Canada)", ""), zone ] }, @job.timezone), class: form_input_class %>
          </div>
        </div>

        <fieldset>
          <legend class="<%= label_class %>">Available time slots</legend>
          <p class="text-xs text-slate-500 dark:text-slate-400">Select the times you're available for walkthroughs.</p>
          <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-5">
            <% JobsHelper::WALKTHROUGH_TIME_OPTIONS.each do |time| %>
              <label class="<%= trade_checkbox_label_classes %>">
                <%= check_box_tag "times[]", time, time == "09:00", id: "times_#{time.delete(":")}", class: "h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" %>
                <span><%= walkthrough_time_label(time) %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <label class="flex cursor-pointer items-start gap-3 border-t border-[var(--color-border)] pt-5">
          <%= check_box_tag :walkthrough_required, "1", @job.walkthrough_required?, class: "peer sr-only" %>
          <span class="relative mt-0.5 h-6 w-11 shrink-0 rounded-full bg-slate-300 transition-colors after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:transition-transform after:content-[''] peer-checked:bg-brand-500 peer-checked:after:translate-x-5 peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500 peer-focus-visible:ring-offset-2"></span>
          <span>
            <span class="block text-sm font-semibold text-slate-900 dark:text-slate-100">Walkthrough required to submit a proposal</span>
            <span class="block text-xs text-slate-500 dark:text-slate-400">Contractors must book a walkthrough before they can submit a proposal for this job.</span>
          </span>
        </label>

        <div class="max-w-xs">
          <%= label_tag :slot_capacity, "Capacity", class: label_class %>
          <%= select_tag :slot_capacity, options_for_select((1..5).map { |n| [ "#{n} #{"contractor".pluralize(n)} per slot", n ] }, @job.slot_capacity), class: form_input_class %>
        </div>

        <%= submit_tag "Publish availability", class: "#{button_classes(:primary)} cursor-pointer", data: { turbo_submits_with: "Publishing..." } %>
      <% end %>
    <% end %>

    <div class="<%= panel_card_class %>">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Booked appointments</h2>
      <p class="text-sm text-slate-500 dark:text-slate-400">Contractors who have scheduled a walkthrough.</p>

      <% if @bookings.any? %>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full text-sm table_class">
            <thead>
              <tr><th>Time</th><th>Contractor</th><th>Status</th></tr>
            </thead>
            <tbody>
              <% @bookings.each do |booking| %>
                <tr>
                  <td class="whitespace-nowrap"><%= format_slot_range(booking.walkthrough_slot) %></td>
                  <td><%= booking.contractor.display_name %></td>
                  <td><%= status_badge "Confirmed", :green %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-4 text-sm text-slate-500 dark:text-slate-400">No walkthroughs booked yet.</p>
      <% end %>
    </div>
  </div>

  <aside class="rounded-2xl border border-brand-200 bg-brand-50/60 p-6 dark:border-brand-800 dark:bg-brand-900/10">
    <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Contractor booking preview</h2>
    <p class="text-sm text-slate-500 dark:text-slate-400">Here's what contractors will see when booking a walkthrough.</p>

    <div class="mt-4 rounded-xl border border-[var(--color-border)] bg-[var(--color-surface-card)] p-4">
      <p class="font-semibold text-slate-900 dark:text-slate-100"><%= @job.title %></p>
      <p class="text-xs text-slate-500 dark:text-slate-400"><%= @job.property.name %></p>
      <p class="mt-3 text-sm font-medium text-slate-700 dark:text-slate-300">Select a walkthrough time</p>
      <p class="text-xs text-slate-500 dark:text-slate-400">Times are shown in <%= @job.timezone.sub(" (US & Canada)", "") %>.</p>

      <% if @slots.empty? %>
        <p class="mt-3 rounded-lg border border-dashed border-slate-300 p-3 text-center text-xs text-slate-500 dark:border-slate-600 dark:text-slate-400">No walkthrough times published yet.</p>
      <% else %>
        <% @slots.group_by(&:day_label).each do |day, slots| %>
          <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400"><%= day %></p>
          <ul class="mt-1 space-y-2">
            <% slots.each do |slot| %>
              <li class="flex items-center justify-between gap-2 rounded-lg border border-[var(--color-border)] px-3 py-2 text-sm">
                <span class="<%= slot.full? ? "text-slate-400 line-through" : "text-slate-800 dark:text-slate-100" %>"><%= slot.time_range_label %></span>
                <span class="flex items-center gap-2">
                  <% if slot.full? %>
                    <span class="text-xs text-slate-500 dark:text-slate-400">Booked</span>
                  <% else %>
                    <span class="text-xs font-medium text-emerald-700 dark:text-emerald-300">Available (<%= slot.remaining %>)</span>
                  <% end %>
                  <% if can_edit_slots %>
                    <%= button_to "Remove", job_walkthrough_slot_path(@job, slot), method: :delete, class: "text-xs text-rose-600 hover:text-rose-700 dark:text-rose-400", form: { data: { turbo_confirm: "Remove this time slot?" } } %>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>
    </div>
  </aside>
</div>

<% if @job.status_draft? %>
  <div class="mt-8 flex flex-wrap items-center justify-between gap-3">
    <%= link_to "Back", edit_job_path(@job), class: button_classes(:secondary) %>
    <%= link_to "Continue to review", review_job_path(@job), class: button_classes(:primary) %>
  </div>
<% end %>
