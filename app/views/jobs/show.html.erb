<% content_for :title, @job.title %>

<%= render "jobs/header", job: @job %>
<%= render "jobs/tabs", job: @job, active: :overview %>

<% if @job.status_draft? %>
  <div class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-brand-200 bg-brand-50 p-4 text-sm text-brand-900 dark:border-brand-800 dark:bg-brand-900/20 dark:text-brand-100">
    <p>This job is a draft. Finish setup to start receiving proposals.</p>
    <%= link_to "Continue setup", review_job_path(@job), class: button_classes(:primary, size: :sm) %>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-3">
  <div class="space-y-6 lg:col-span-2">
    <div class="<%= panel_card_class %> space-y-5">
      <div>
        <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400">Description</h2>
        <p class="mt-1 whitespace-pre-line text-slate-900 dark:text-slate-100"><%= @job.description.presence || "No description provided." %></p>
      </div>
      <div>
        <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400">Trades needed</h2>
        <div class="mt-1 flex flex-wrap gap-2"><%= trade_badges(@job.trades) %></div>
      </div>
      <% if @job.work_order %>
        <div>
          <h2 class="text-sm font-medium text-slate-500 dark:text-slate-400">Work order</h2>
          <p class="mt-1"><%= link_to @job.work_order.title, work_order_path(@job.work_order), class: "font-medium text-brand-700 hover:text-brand-800 dark:text-brand-300" %></p>
        </div>
      <% end %>
    </div>

    <% if @job.attachments.attached? %>
      <div class="<%= panel_card_class %>">
        <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-slate-100">Photos and documents</h2>
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          <% @job.attachments.each do |file| %>
            <%= link_to rails_blob_path(file, disposition: "inline"), target: "_blank", rel: "noopener", class: "block overflow-hidden rounded-lg border border-[var(--color-border)] text-center" do %>
              <% if file.image? %>
                <%= image_tag file.variant(resize_to_fill: [ 300, 300 ]), class: "aspect-square w-full object-cover", alt: file.filename.to_s %>
              <% else %>
                <div class="flex aspect-square flex-col items-center justify-center gap-2 bg-slate-50 p-2 text-slate-500 dark:bg-slate-700/40">
                  <%= icon_tag :document, classes: "h-8 w-8" %>
                  <span class="line-clamp-2 break-all text-xs"><%= file.filename %></span>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <aside class="space-y-4">
    <div class="<%= panel_card_class %>">
      <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">At a glance</h2>
      <dl class="mt-3 space-y-3 text-sm">
        <div class="flex justify-between"><dt class="text-slate-500 dark:text-slate-400">Proposals</dt><dd class="font-medium text-slate-900 dark:text-slate-100"><%= @proposals.size %></dd></div>
        <div class="flex justify-between"><dt class="text-slate-500 dark:text-slate-400">Walkthroughs booked</dt><dd class="font-medium text-slate-900 dark:text-slate-100"><%= @bookings.size %></dd></div>
        <div class="flex justify-between"><dt class="text-slate-500 dark:text-slate-400">Walkthrough required</dt><dd class="font-medium text-slate-900 dark:text-slate-100"><%= @job.walkthrough_required? ? "Yes" : "No" %></dd></div>
        <% if @proposals.any? %>
          <div class="flex justify-between"><dt class="text-slate-500 dark:text-slate-400">Lowest proposal</dt><dd class="font-medium text-slate-900 dark:text-slate-100"><%= format_cents(@proposals.map(&:amount_cents).min) %></dd></div>
        <% end %>
      </dl>
      <% if @proposals.any? %>
        <div class="mt-4"><%= link_to "Compare proposals", job_proposals_path(@job), class: "#{button_classes(:primary)} w-full" %></div>
      <% end %>
    </div>
  </aside>
</div>
