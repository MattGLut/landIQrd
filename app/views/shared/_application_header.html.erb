<header
  id="application-header"
  class="sticky top-0 z-50 border-b border-[var(--color-border)] bg-[var(--color-surface-card)]">
  <div class="flex items-center justify-between gap-4 px-4 py-3 md:px-8">
    <div class="flex min-w-0 items-center gap-3 md:hidden">
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-md text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
        data-action="click->mobile-nav#toggle"
        data-mobile-nav-target="button"
        aria-controls="mobile-nav-panel"
        aria-expanded="false"
        aria-label="Open main menu">
        <span data-mobile-nav-target="iconMenu"><%= icon_tag :menu %></span>
        <span class="hidden" data-mobile-nav-target="iconClose"><%= icon_tag :close %></span>
      </button>
      <%= link_to dashboard_path_for(current_user), class: "min-w-0" do %>
        <%= render "shared/wordmark", size: "text-xl", by: false %>
      <% end %>
    </div>

    <nav class="hidden min-w-0 md:block" aria-label="Current section">
      <ol class="flex items-center gap-2 truncate text-sm text-[var(--color-text-muted)]">
        <% crumbs = header_crumbs(current_user) %>
        <% crumbs.each_with_index do |crumb, index| %>
          <% last = index == crumbs.size - 1 %>
          <% if index.positive? %><li aria-hidden="true">/</li><% end %>
          <li class="truncate <%= last ? "font-medium text-[var(--color-text-primary)]" : "" %>" <%= "aria-current=page" if last %>><%= crumb %></li>
        <% end %>
      </ol>
    </nav>

    <div class="flex items-center gap-3">
      <% unread = unread_conversations_count(current_user) %>
      <%= link_to conversations_path, class: "relative inline-flex h-10 w-10 items-center justify-center rounded-full text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500", "aria-label": "Messages#{unread.positive? ? " (#{unread} unread)" : ""}" do %>
        <%= icon_tag :bell %>
        <% if unread.positive? %>
          <span class="absolute right-1.5 top-1.5 h-2.5 w-2.5 rounded-full bg-brand-500 ring-2 ring-white dark:ring-slate-800"></span>
        <% end %>
      <% end %>

      <div
        class="relative"
        data-controller="account-menu"
        data-action="click@window->account-menu#closeIfOutside keydown@window->account-menu#keydown turbo:before-visit@document->account-menu#close turbo:before-cache@document->account-menu#close">
        <button
          type="button"
          class="account-menu-trigger flex cursor-pointer items-center gap-2 rounded-full py-1 pl-1 pr-2 text-left text-sm text-[var(--color-text-primary)] hover:bg-[var(--color-surface-hover)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-500"
          data-account-menu-target="button"
          data-action="click->account-menu#toggle"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="account-menu">
          <%= render "shared/user_avatar", user: current_user, size: :sm %>
          <span class="hidden leading-tight sm:block">
            <span class="block text-sm font-medium"><%= current_user.display_name %></span>
            <span class="block text-xs text-[var(--color-text-muted)]"><%= current_user.role.humanize %></span>
          </span>
        </button>
        <div
          id="account-menu"
          role="menu"
          data-account-menu-target="menu"
          class="absolute right-0 top-full z-30 mt-1 hidden w-48 rounded-md border border-[var(--color-border)] bg-[var(--color-surface-card)] py-1 shadow-lg">
          <%= link_to "Account settings", edit_account_path, role: "menuitem", class: "block px-4 py-2 text-sm text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)]" %>
          <hr class="my-1 border-[var(--color-border)]">
          <%= button_to "Sign out", destroy_user_session_path, method: :delete, form_class: "block w-full", role: "menuitem", class: "block w-full cursor-pointer px-4 py-2 text-left text-sm text-[var(--color-text-secondary)] hover:bg-[var(--color-surface-hover)]" %>
        </div>
      </div>
    </div>
  </div>

  <div
    id="mobile-nav-panel"
    class="hidden bg-[var(--color-sidebar)] md:hidden"
    data-mobile-nav-target="panel"
    data-action="click->mobile-nav#handlePanelNavigate"
    aria-hidden="true">
    <nav class="space-y-1 px-3 py-3" aria-label="Mobile">
      <% sidebar_items_for(current_user).each do |item| %>
        <%= sidebar_link(item) %>
      <% end %>
    </nav>
  </div>
</header>

