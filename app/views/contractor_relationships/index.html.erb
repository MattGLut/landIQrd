<% content_for :title, "Contacts" %>

<%= render "shared/page_header",
      title: "Contacts",
      subtitle: "Landlords who want to assign you jobs without a proposal." %>

<% if @relationships.any? %>
  <div class="space-y-3">
    <% @relationships.each do |relationship| %>
      <div class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white p-4 shadow-sm dark:border-slate-700 dark:bg-slate-800">
        <div>
          <p class="font-medium text-slate-900 dark:text-slate-100"><%= relationship.landlord.display_name %></p>
          <p class="mt-1 text-sm text-slate-500 dark:text-slate-400"><%= relationship.label %></p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <%= status_badge relationship.status_label, relationship.status_color %>
          <% if relationship.status_pending? %>
            <%= button_to "Accept", accept_contractor_relationship_path(relationship), class: button_classes(:primary, size: :sm) %>
            <%= button_to "Decline", decline_contractor_relationship_path(relationship), class: button_classes(:secondary, size: :sm) %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <%= render "shared/empty_state",
        title: "No contact requests",
        description: "When a landlord asks to assign you jobs directly, the request shows up here." %>
<% end %>
